# ============================================================================
#  Qwen-Free-API configuration
#  Copy this file to `.env` and edit — or just run start.sh / start.bat
#  and one will be created for you. Every value is optional; real
#  environment variables always override .env values.
# ============================================================================

# ── Qwen account token(s) ───────────────────────────────────────────────────
# A JWT from chat.qwen.ai. Multi-account: separate with commas — the pool
# round-robins between them and transparently fails over on rate limits.
#   How to get one:
#     1. Log in at https://chat.qwen.ai
#     2. Press F12 → Application → Cookies → https://chat.qwen.ai → copy `token`
#        (or Console: document.cookie.split('; ').find(c=>c.startsWith('token=')).slice(6))
#     3. Paste the long JWT string here
# With at least one token: qwen3.8-max + full model family, vision caps, 1M context.
# Leave empty for guest mode (no account — datacenter IPs may hit WAF captcha).
QWEN_TOKENS=

# (Single-token variable — QWEN_TOKENS wins when both are set.)
# QWEN_TOKEN=

# ── Server ──────────────────────────────────────────────────────────────────
PORT=8080
HOST=0.0.0.0
# The key your clients must send (Authorization: Bearer <key> / x-api-key).
# CHANGE THIS if you expose the server beyond localhost!
AUTH_TOKEN=qwen

# ── Multi-account tuning ───────────────────────────────────────────────────
# First rate-limit cooldown in seconds; consecutive hits double it (cap 30 min).
ACCOUNT_COOLDOWN_BASE=120
# How long a request waits in the queue when EVERY account is rate-limited
# or dead, before a 503 is returned (0 = wait forever).
ACCOUNT_QUEUE_TIMEOUT=120

# ── Agent mode (tool calling for agent frameworks) ──────────────────────────
# Translates OpenAI/Anthropic tools into Qwen prompts and rewrites the
# model's <<<TOOL_CALL>>> blocks back into native tool_calls / tool_use.
AGENT_MODE=false
AGENT_MODE_VARIANT=modern
